    public static boolean findStraightPath(String[][] maze, int row, int col) {
        int rows = maze.length;
        int columns = maze[0].length;


        if (row < 0 || row >= rows || col < 0 || col >= columns) {
            return false;
        }

        if (row == rows - 1 && col == columns - 1) {
            return true;
        }

        path.add(new int[]{row, col});

        return true;
    }

    public static int findLongestPathIfTwo(int firstPath, int secondPath) {
        int longestPath = 0;
        if (firstPath > secondPath) {
            longestPath = firstPath;
        }

        if (firstPath < secondPath) {
            longestPath = secondPath;
        }

        return longestPath;
    }

    public static int findLongestPathIfThree(int firstPath, int secondPath, int thirdPath) {
        int longestPath = 0;
        if (firstPath > secondPath && firstPath > thirdPath) {
            longestPath = firstPath;
        }

        if (firstPath < secondPath && secondPath > thirdPath) {
            longestPath = secondPath;
        }

        if (firstPath < thirdPath && thirdPath > secondPath) {
            longestPath = thirdPath;
        }
        return longestPath;
    }

    public static int findLongestPathIfFour(int firstPath, int secondPath, int thirdPath, int fourthPath) {
        int longestPath = 0;
        if (firstPath > secondPath && firstPath > thirdPath && firstPath > fourthPath) {
            longestPath = firstPath;
        }

        if (firstPath < secondPath && secondPath > thirdPath && secondPath > fourthPath) {
            longestPath = secondPath;
        }

        if (firstPath < thirdPath && thirdPath > secondPath && thirdPath > fourthPath) {
            longestPath = thirdPath;
        }

        if (firstPath < fourthPath && fourthPath > secondPath && fourthPath > thirdPath) {
            longestPath = fourthPath;
        }
        return longestPath;
    }

    public static void printPath(ArrayList<int[]> path) {
        if (path != null) {
            System.out.println("Path:");
            for (int[] point : path) {
                System.out.print(("(" + point[0] + ", " + point[1] + ") ---> "));
            }


        }
        else {
            System.out.println("Invalid Maze. This is abysmal..");
        }
    }
